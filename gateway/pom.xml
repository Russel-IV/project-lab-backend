<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.team1</groupId>
		<artifactId>project-lab-backend</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>gateway</artifactId>
	<name>gateway</name>
	<description>
		GraphQL/REST front door (docs/adr/0004, docs/adr/0005). Hosts the actual GraphQL
		schema and today's REST paths directly; as each domain service is extracted, its
		resolvers/controllers here swap from local repositories to Feign calls.
	</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-graphql</artifactId>
		</dependency>
		<dependency>
			<groupId>com.graphql-java</groupId>
			<artifactId>graphql-java-extended-scalars</artifactId>
			<version>22.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- docs/adr/0025: spring-boot-starter-webflux only autoconfigures the SERVER
		     side (WebFluxAutoConfiguration, incoming requests) — it does not
		     transitively pull in ReactiveHttpClientAutoConfiguration, which is what
		     provides the (tracing-instrumented, once micrometer-tracing is also on the
		     classpath) ClientHttpConnector bean WebClientConfig.kt wires into the
		     @LoadBalanced builder. Without this, WebClient.builder() with no explicit
		     .clientConnector(...) falls back to Reactor Netty's bare defaults —
		     confirmed live: gateway's own spans reached Zipkin fine, but zero trace
		     propagation into any downstream service, silently. Same "one more artifact"
		     shape as FeignHttpMessageConvertersWarmup.kt's race and feign-micrometer's
		     necessity in the original migration. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-http-client</artifactId>
		</dependency>
		<!-- Distributed tracing (docs/adr/0013) — auto-instruments Spring MVC/GraphQL,
		     OpenFeign, and JDBC, and auto-propagates trace/span IDs across Feign calls
		     with no per-call-site code. Exported to Zipkin (docker-compose.yml). -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-zipkin</artifactId>
		</dependency>
		<!-- This fictional Spring Boot 4.0.6 splits tracing auto-configuration into
		     separate artifacts not transitively pulled in by spring-boot-starter-actuator
		     or micrometer-tracing-bridge-otel alone (confirmed by inspecting each jar's
		     AutoConfiguration.imports — spring-boot-actuator-autoconfigure has none of
		     it). spring-boot-micrometer-tracing-opentelemetry wires the OTel bridge into
		     Spring's ObservationRegistry/MDC and provides ZipkinWithOpenTelemetryTracingAutoConfiguration;
		     spring-boot-zipkin provides the management.zipkin.tracing.endpoint property
		     binding and the actual Zipkin sender bean. Without both, tracing silently
		     does nothing — no MDC traceId, no spans reaching Zipkin, no errors either. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-zipkin</artifactId>
		</dependency>
		<!-- docs/adr/0025: reactive web layer (supersedes spring-boot-starter-webmvc) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>
		<!-- docs/adr/0025: coroutines are the idiom used throughout the gateway's
		     reactive code (suspend fun resolvers/clients) rather than raw Mono/Flux
		     chaining; version managed by spring-boot-starter-parent's BOM. -->
		<dependency>
			<groupId>org.jetbrains.kotlinx</groupId>
			<artifactId>kotlinx-coroutines-reactor</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- docs/adr/0009: OAuth2 Resource Server replaces the hand-written JwtAuthFilter -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<!-- docs/adr/0006: service discovery -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>
		<!-- docs/adr/0025: @LoadBalanced WebClient.Builder resolves target services via
		     Eureka the same way Feign clients did — added explicitly rather than relying
		     on transitive resolution, per this project's track record of transitive
		     load-balancer wiring gaps (see FeignConfig.kt's own doc comment, now removed
		     with it). -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-loadbalancer</artifactId>
		</dependency>
		<!-- docs/adr/0025: Feign (spring-cloud-starter-openfeign, feign-okhttp,
		     feign-micrometer) removed — all 21 gateway outbound clients now use the
		     @LoadBalanced WebClient in WebClientConfig.kt. WebClient supports PATCH
		     natively (the reason feign-okhttp existed), and trace propagation across
		     WebClient calls needs live Zipkin verification (Phase 7) the same way
		     feign-micrometer's necessity was originally discovered live, not assumed. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.jetbrains.kotlin</groupId>
			<artifactId>kotlin-reflect</artifactId>
		</dependency>
		<dependency>
			<groupId>org.jetbrains.kotlin</groupId>
			<artifactId>kotlin-stdlib</artifactId>
		</dependency>
		<dependency>
			<groupId>tools.jackson.module</groupId>
			<artifactId>jackson-module-kotlin</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-api</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.jetbrains.kotlinx</groupId>
			<artifactId>kotlinx-coroutines-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.jetbrains.kotlin</groupId>
			<artifactId>kotlin-test-junit5</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- docs/adr/0025: WireMock contract tests (BookingFeignClientTest,
		     MediaFeignClientTest, ReviewFeignClientTest) now build their client under
		     test with a plain WebClient — feign-jackson and the classic
		     com.fasterxml.jackson test-only deps it needed retired with Feign itself. -->
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-standalone</artifactId>
			<version>3.13.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
		<testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
