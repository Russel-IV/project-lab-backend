"Physical address input used when creating or updating a stay."
input AddressInput {
    "Primary street line (e.g. '123 Main St')."
    streetAddress: String!
    "Apartment, floor, or unit number."
    extendedAddress: String
    city: String!
    "State or province."
    stateProvince: String
    postalCode: String
    "ISO 3166-1 alpha-2 country code (e.g. 'US', 'GB')."
    countryCode: String!
}

"Input for creating a new stay listing."
input CreateStayInput {
    "Display name of the property."
    name: String!
    "Description of the property."
    about: String
    "Category of property."
    propertyType: PropertyType!
    "Physical address of the property."
    address: AddressInput!
    "Whether the booking is eligible for a full refund on cancellation."
    isRefundable: Boolean! = false
    "Official star rating (e.g. 4.5)."
    starRating: BigDecimal
    "Days before check-in within which the booking can be cancelled."
    daysFromBookingCancellationDeadline: Int
    "House rules and cancellation policies."
    policiesText: String
    "Key information guests should know before arrival."
    importantInformation: String
    "ID of the host managing this property."
    hostId: Int!
    "ID of the brand or chain this property belongs to."
    propertyBrandId: Int
    "IDs of view types available at this property."
    viewIds: [Int!]! = []
    "IDs of amenities offered at this property."
    amenityIds: [Int!]! = []
    "IDs of accessibility features available."
    accessibilityIds: [Int!]! = []
    "IDs of meal plans offered."
    mealPlanIds: [Int!]! = []
    "IDs of accepted payment types."
    paymentTypeIds: [Int!]! = []
    "IDs of traveler experience categories."
    travelerExperienceIds: [Int!]! = []
    "Geographic coordinates of the property. Omit to leave unset."
    location: LocationInput
}

"Input for updating an existing stay listing. Replaces all provided fields."
input UpdateStayInput {
    "Updated display name."
    name: String!
    "Updated description."
    about: String
    "Updated property category."
    propertyType: PropertyType!
    "Updated address."
    address: AddressInput!
    "Updated refund eligibility."
    isRefundable: Boolean! = false
    "Updated star rating."
    starRating: BigDecimal
    "Updated cancellation deadline in days."
    daysFromBookingCancellationDeadline: Int
    "Updated policies text."
    policiesText: String
    "Updated important information."
    importantInformation: String
    "Updated host ID."
    hostId: Int!
    "Updated property brand ID."
    propertyBrandId: Int
    "Updated list of view type IDs."
    viewIds: [Int!]! = []
    "Updated list of amenity IDs."
    amenityIds: [Int!]! = []
    "Updated list of accessibility feature IDs."
    accessibilityIds: [Int!]! = []
    "Updated list of meal plan IDs."
    mealPlanIds: [Int!]! = []
    "Updated list of accepted payment type IDs."
    paymentTypeIds: [Int!]! = []
    "Updated list of traveler experience IDs."
    travelerExperienceIds: [Int!]! = []
    "Updated geographic coordinates. Omit to clear the location."
    location: LocationInput
}

"WGS-84 geographic coordinates input."
input LocationInput {
    "Latitude in decimal degrees (-90 to 90)."
    latitude: Float!
    "Longitude in decimal degrees (-180 to 180)."
    longitude: Float!
}

"Search and availability filter for the stays query. All fields are optional and combined with AND logic."
input StayFilterInput {
    "Case-insensitive city name substring match."
    city: String @deprecated(reason: "use regionId")
    "Exact ISO 3166-1 alpha-2 country code match (e.g. 'US', 'GB')."
    countryCode: String @deprecated(reason: "use regionId")
    "Stable destination identifier (docs/adr/0018) — the preferred replacement for city/countryCode, immune to same-name-different-region collisions."
    regionId: Int
    "Limit results to a specific property category."
    propertyType: PropertyType
    "Require at least one room with a nightly rate at or below this amount."
    maxPricePerNight: BigDecimal
    "Require at least one room with a nightly rate at or above this amount."
    minPricePerNight: BigDecimal
    "Availability check start date. Must be provided together with checkOut."
    checkIn: Date
    "Availability check end date. Must be provided together with checkIn."
    checkOut: Date
    "Minimum number of guests that at least one available room must accommodate."
    guests: Int
    "Limit results to properties with one of these star rating tiers (1-5). A property matches a tier if its starRating rounds to it."
    starRatings: [Int!]
    "Limit results to properties with a room having one of these bedroom counts. Use 4 to mean 4 or more bedrooms."
    bedrooms: [Int!]
    "Limit results to properties offering ALL of these property-level amenities (e.g. Wi-Fi, pool, parking, gym, pet-friendly)."
    propertyAmenityIds: [Int!]
    "Limit results to properties offering ALL of these in-room amenities (e.g. air conditioning, kitchen, balcony, private bathroom, washer) somewhere on the property."
    roomAmenityIds: [Int!]
}

"Input for updating a stay picture's metadata. Does not replace the image file."
input UpdateStayPictureInput {
    "Optional descriptive caption."
    caption: String
    "Set to true to make this the cover photo for the listing."
    isPrimary: Boolean! = false
    "Sort order for display. Lower values appear first."
    displayOrder: Int! = 0
}
