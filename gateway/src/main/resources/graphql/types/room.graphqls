"A bookable room within a stay."
type Room {
    id: Int!
    "ID of the stay this room belongs to."
    stayId: Int!
    "Display name of the room (e.g. 'Deluxe King', 'Studio Suite')."
    name: String!
    "Nightly price in the property's local currency."
    price: BigDecimal!
    "Maximum number of guests this room accommodates."
    sleeps: Int!
    "Number of bedrooms."
    bedroomAmount: Int!
    "Number of bathrooms (allows half-baths, e.g. 1.5)."
    bathrooms: BigDecimal!
    "Room size in square metres. Null if not specified."
    size: BigDecimal
    "Photos of this room."
    pictures: [RoomPicture!]!
}

"A photo associated with a room."
type RoomPicture {
    id: Int!
    "ID of the room this picture belongs to."
    roomId: Int!
    "Public URL of the image."
    url: String!
    "Public URL of a resized (max ~400px wide) variant, for grid/thumbnail display. Falls back to the full-size url if no thumbnail could be generated."
    thumbnailUrl: String!
    "Optional descriptive caption."
    caption: String
    "Whether this is the main cover photo shown for the room."
    isPrimary: Boolean!
    "Sort order for display. Lower values appear first."
    displayOrder: Int!
}
