"A bookable room within a stay."
type Room {
    id: Int!
    "ID of the stay this room belongs to."
    stayId: Int!
    "Display name of the room (e.g. 'Deluxe King', 'Studio Suite')."
    name: String!
    "Nightly price in the property's local currency."
    price: BigDecimal!
    "Maximum number of guests this room accommodates."
    sleeps: Int!
    "Number of bedrooms."
    bedroomAmount: Int!
    "Number of bathrooms (allows half-baths, e.g. 1.5)."
    bathrooms: BigDecimal!
    "Room size in square metres. Null if not specified."
    size: BigDecimal
    "Photos of this room."
    pictures: [RoomPicture!]!
    "In-room amenities (e.g. air conditioning, kitchen, balcony)."
    amenities: [Amenity!]!
}

"A photo associated with a room."
type RoomPicture {
    id: Int!
    "ID of the room this picture belongs to."
    roomId: Int!
    "Public URL of the image."
    url: String!
    "Public URL of a resized (max ~248px wide) variant, for grid/thumbnail display. Falls back to the full-size url if no thumbnail could be generated."
    thumbnailUrl: String!
    "Public URL of a resized (max ~1024px wide) variant, for hero/gallery display. Null if the source is already narrower than 1024px or no variant could be generated."
    url1024: String
    "Public URL of a resized (max ~768px wide) variant, for the mid-size srcSet slot between card and hero display. Null if the source is already narrower than 768px or no variant could be generated."
    url768: String
    "Public URL of a resized (max ~512px wide) variant, for card/grid display. Null if the source is already narrower than 512px or no variant could be generated."
    url512: String
    "Optional descriptive caption."
    caption: String
    "Whether this is the main cover photo shown for the room."
    isPrimary: Boolean!
    "Sort order for display. Lower values appear first."
    displayOrder: Int!
}
