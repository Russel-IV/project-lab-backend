 que<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.team1</groupId>
		<artifactId>project-lab-backend</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>inventory-service</artifactId>
	<name>inventory-service</name>
	<description>
		Inventory domain (docs/adr/0002, docs/adr/0010), extracted per Phase 5 of the
		migration plan. Owns Stay, Room, Address, PropertyBrand and the six lookup
		tables (Amenity, Accessibility, MealPlan, PaymentType, TravelerExperience,
		View) and their own Postgres/PostGIS database and Flyway history. Calls
		identity-service (host existence) and booking-service (availability conflict
		checks, Resilience4j-wrapped per docs/adr/0010) via Feign; exposes a plain
		internal REST API consumed by the Gateway's Feign clients (docs/adr/0005,
		docs/adr/0008).
	</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Distributed tracing (docs/adr/0013) — auto-instruments Spring MVC, OpenFeign,
		     and JDBC, and auto-propagates trace/span IDs across Feign calls with no
		     per-call-site code. Exported to Zipkin (docker-compose.yml). -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-zipkin</artifactId>
		</dependency>
		<!-- This fictional Spring Boot 4.0.6 splits tracing auto-configuration into
		     separate artifacts not transitively pulled in by spring-boot-starter-actuator
		     or micrometer-tracing-bridge-otel alone (confirmed by inspecting each jar's
		     AutoConfiguration.imports — spring-boot-actuator-autoconfigure has none of
		     it). spring-boot-micrometer-tracing-opentelemetry wires the OTel bridge into
		     Spring's ObservationRegistry/MDC and provides ZipkinWithOpenTelemetryTracingAutoConfiguration;
		     spring-boot-zipkin provides the management.zipkin.tracing.endpoint property
		     binding and the actual Zipkin sender bean. Without both, tracing silently
		     does nothing — no MDC traceId, no spans reaching Zipkin, no errors either. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-zipkin</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-spatial</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-openfeign</artifactId>
		</dependency>
		<!-- Same OkHttp/LoadBalancer wiring gap as gateway's config/FeignConfig.kt —
		     this fictional spring-cloud-openfeign 5.0.2 has no built-in OkHttp
		     auto-configuration and DefaultFeignLoadBalancerConfiguration hardcodes
		     Client.Default as its wrapped delegate, so both feign-okhttp and an
		     explicit FeignBlockingLoadBalancerClient bean are required here too. -->
		<dependency>
			<groupId>io.github.openfeign</groupId>
			<artifactId>feign-okhttp</artifactId>
		</dependency>
		<!-- Trace propagation across Feign calls (docs/adr/0013) needs this on the
		     classpath: Spring Cloud OpenFeign's FeignClientsConfiguration only adds a
		     feign.micrometer.MicrometerObservationCapability to the Feign.Builder (a
		     Feign Capability, wired independently of which Client bean handles
		     transport — so this is unrelated to the OkHttp/LoadBalancer Client wiring
		     above) when feign.micrometer.MicrometerObservationCapability is actually
		     resolvable, which requires this artifact explicitly — micrometer-tracing-
		     bridge-otel alone doesn't provide it. Without it, tracing/MDC still work
		     locally in this service, but no propagation headers are ever added to
		     outgoing Feign requests, so the callee starts a brand new, disconnected
		     trace instead of continuing this one — confirmed live via Zipkin showing
		     single-service traces instead of ones spanning the Feign call. -->
		<dependency>
			<groupId>io.github.openfeign</groupId>
			<artifactId>feign-micrometer</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
		</dependency>
		<dependency>
			<groupId>org.jetbrains.kotlin</groupId>
			<artifactId>kotlin-reflect</artifactId>
		</dependency>
		<dependency>
			<groupId>org.jetbrains.kotlin</groupId>
			<artifactId>kotlin-stdlib</artifactId>
		</dependency>
		<dependency>
			<groupId>tools.jackson.module</groupId>
			<artifactId>jackson-module-kotlin</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.jetbrains.kotlin</groupId>
			<artifactId>kotlin-test-junit5</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
		<testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
