{
  "name": "project-lab-backend",
  "version": "1.0.0",
  "description": "Kotlin & Spring Boot backend project with pre-commit formatting",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "docs": "spectaql spectaql.yml --schema-file \"gateway/src/main/resources/graphql/schema.graphqls\" --schema-file \"gateway/src/main/resources/graphql/types/*.graphqls\" --schema-file \"gateway/src/main/resources/graphql/inputs/*.graphqls\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "spectaql": "^3.0.0"
  }
}
