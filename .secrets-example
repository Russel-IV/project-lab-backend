# GitHub Actions Secrets Example File
# Copy this file to '.secrets' to use it with 'act' for local run testing.
# WARNING: Do not commit the actual '.secrets' file or any file with real secrets to GitHub.

# AWS OIDC Role and Region
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/github-actions-ecr-role
AWS_REGION=us-east-1

# EC2 Instance SSH Connection
EC2_HOST=54.123.45.67
EC2_USER=ubuntu
EC2_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# Application Database Configurations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=project_lab_db

# Security & CORS
JWT_SECRET=your_jwt_signing_secret_key_at_least_256_bits
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Third-Party API Keys
SPRING_AI_OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
